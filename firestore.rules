rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 管理員（要更換時，config.js 裡的 SHARK_ADMIN 也要一起改）
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'hi2002no@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function approved(uid) {
      return exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.status == 'approved';
    }
    function validRequest() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.email == request.auth.token.email
        && d.requestedAt == request.time
        && d.name is string && d.name.size() <= 80;
    }

    function mine(uid) { return signedIn() && request.auth.uid == uid && approved(uid); }
    // 每筆資料的格式與大小限制（避免異常的大量資料）
    function validDoc(kind) {
      let d = request.resource.data;
      return kind in ['meta', 'drafts', 'sessions', 'metrics', 'archive']
        && d.keys().hasOnly(['json', 'updatedAt'])
        && d.json is string && d.json.size() < 300000
        && d.updatedAt == request.time;
    }

    // 訓練資料：本人（已核准）或管理員
    match /users/{uid}/{kind}/{id} {
      allow read, delete: if isAdmin() || mine(uid);
      allow create, update: if isAdmin() || (mine(uid) && validDoc(kind));
    }

    // 排行榜：全部成員放在同一份文件（每人一欄，欄名＝帳號 uid），只有已核准的成員看得到
    // 一般成員只能新增／修改／刪除自己那一欄；管理員可以改任何欄（含 _mod：隱藏紀錄、改暱稱、移出排行）
    function myEntryOk() {
      let d = request.resource.data;
      return !(request.auth.uid in d) || (d[request.auth.uid] is string && d[request.auth.uid].size() < 12000);
    }
    match /leaderboard/{id} {
      allow get: if id == 'main' && (isAdmin() || (signedIn() && approved(request.auth.uid)));
      allow create: if id == 'main' && (isAdmin() || (signedIn() && approved(request.auth.uid)
        && request.resource.data.keys().hasOnly([request.auth.uid]) && myEntryOk()));
      allow update: if id == 'main' && (isAdmin() || (signedIn() && approved(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]) && myEntryOk()));
    }

    // 使用權限：本人只能送出申請；狀態只有管理員能改
    match /access/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'requestedAt'])
        && validRequest());
      // 被拒絕或停用滿 7 天後，可以重新申請一次；封鎖、已移轉不行
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && resource.data.status in ['rejected', 'removed']
        && request.time > resource.data.decidedAt + duration.value(7, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'status', 'requestedAt'])
        && validRequest());
    }
  }
}
